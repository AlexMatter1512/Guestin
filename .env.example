# Optional local configuration. Keys are generated on first startup and saved
# beside SQLite in runtime-secrets.json. The setup token appears in stdout.
# Existing installations can supply their original APP_KEY, SETUP_TOKEN and
# VAPID_PUBLIC_KEY/VAPID_PRIVATE_KEY to adopt them into that file.
ORIGIN=http://localhost:3000
DB_PATH=data/guestin.sqlite
VAPID_SUBJECT=mailto:admin@example.com
# Set only if all traffic comes through a proxy that overwrites X-Real-IP.
TRUST_PROXY=0
# Optional direct TLS certificate paths:
# TLS_CERT=/certs/fullchain.pem
# TLS_KEY=/certs/privkey.pem

# Structured backend diagnostics (timestamps and request/user attribution).
LOG_LEVEL=info
LOG_FILE=data/logs/server.jsonl
LOG_MAX_BYTES=10485760
LOG_ROTATIONS=5

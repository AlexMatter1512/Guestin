# Generate real keys with: bun scripts/init-env.ts
APP_KEY=replace-with-64-hex-characters
SETUP_TOKEN=replace-with-a-long-random-setup-token
ORIGIN=http://localhost:3000
DB_PATH=data/oshost.sqlite
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# Set only if all traffic comes through a proxy that overwrites X-Real-IP.
TRUST_PROXY=0
# Optional direct TLS certificate paths:
# TLS_CERT=/certs/fullchain.pem
# TLS_KEY=/certs/privkey.pem

# Structured backend diagnostics (timestamps and request/user attribution).
LOG_LEVEL=info
LOG_FILE=data/logs/server.jsonl
LOG_MAX_BYTES=10485760
LOG_ROTATIONS=5

{
  "name": "oshost",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "bun --watch server/index.ts",
    "start": "bun server/index.ts",
    "test": "bun test",
    "check": "tsc --noEmit && bun run --cwd apps/host check && bun run --cwd apps/guest check",
    "build": "bun run --cwd apps/host build && bun run --cwd apps/guest build",
    "backup": "bun scripts/backup.ts"
  },
  "dependencies": {
    "hono": "^4.10.0",
    "ical.js": "^2.2.1",
    "ipaddr.js": "^2.2.0",
    "nodemailer": "^10.5.0",
    "web-push": "^3.6.7",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/bun": "^1.3.0",
    "@types/nodemailer": "^8.0.2",
    "@types/web-push": "^3.6.4",
    "clsx": "^2.1.1",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "tailwind-merge": "^3.7.0",
    "typescript": "^5.9.3"
  }
}
